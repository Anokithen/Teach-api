DB_USER=root
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=3306
DB_NAME=teachalike_db
JWT_SECRET_KEY=replace-with-a-long-random-value
# Comma-separated web origins allowed to call this API.
FRONTEND_ORIGINS=http://localhost:3000

# Get the cloud name from your Cloudinary dashboard. Never commit real values.
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# XTTS-v2 narration. TTS downloads weights to XTTS_CACHE_DIR on first use.
# Use a persistent mounted volume in production; CPU inference is slow.
XTTS_MODEL_NAME=tts_models/multilingual/multi-dataset/xtts_v2
XTTS_DEVICE=cpu
XTTS_CACHE_DIR=/app/models/xtts
XTTS_LANGUAGE=en
XTTS_MAX_CHARS_PER_CHUNK=280
# Optional override when ffmpeg is not available on PATH.
# FFMPEG_BINARY=/usr/bin/ffmpeg

# Path to the offline pronunciation model used only by reading sessions.
VOSK_MODEL_PATH=/app/models/vosk-model-small-en-us-0.15
