# MySQL connection settings for local development.
DB_USER=root
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=3306
DB_NAME=teachalike_db
# Railway MySQL also provides MYSQL_URL or MYSQLHOST/MYSQLPORT/MYSQLUSER/
# MYSQLPASSWORD/MYSQLDATABASE. Those variables are detected automatically.
# On the API service, reference the database service, for example:
# MYSQL_URL=${{MySQL.MYSQL_URL}}
# DATABASE_URL=...
JWT_SECRET_KEY=replace-with-a-long-random-value
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRES_DAYS=30
# Comma-separated web origins allowed to call this API. Use * temporarily or
# replace it with the exact deployed Vercel/custom-domain origin.
FRONTEND_ORIGINS=*

# Database initialization retries before the web process starts.
DB_INIT_MAX_ATTEMPTS=10
DB_INIT_RETRY_SECONDS=3

# Get the cloud name from your Cloudinary dashboard. Never commit real values.
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Coqui narration. ``native`` uses XTTS-v2's built-in cloning.
# Set method to ``vc`` to use tts_with_vc_to_file with a compatible base model.
# TTS downloads weights to TTS_CACHE_DIR on first use; CPU inference is slow.
TTS_MODEL_NAME=tts_models/multilingual/multi-dataset/xtts_v2
TTS_VOICE_CLONING_METHOD=native
TTS_DEVICE=cpu
TTS_CACHE_DIR=/app/models/tts
TTS_LANGUAGE=en
TTS_MAX_CHARS_PER_CHUNK=280
# Optional override when ffmpeg is not available on PATH.
# FFMPEG_BINARY=/usr/bin/ffmpeg

# Path to the offline pronunciation model used only by reading sessions.
VOSK_MODEL_PATH=/app/models/vosk-model-small-en-us-0.15
